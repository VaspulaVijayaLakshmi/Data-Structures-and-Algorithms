class Solution {
public:
    vector<int> dp;
    int combinationSum4(vector<int>& nums, int target,int idx){

        if(idx>=nums.size() || target<0)
           return 0;

        if(target==0)
            return 1;

        if(dp[target]!=-1)
          return dp[target];    
        
    
        int take = combinationSum4(nums,target-nums[idx],0);
        int dontTake = combinationSum4(nums,target,idx+1);

        return dp[target] = take+dontTake;
         
    }


    int combinationSum4(vector<int>& nums, int target) {

       dp.resize(target+1,-1);
       return combinationSum4(nums,target,0);

    }
};

