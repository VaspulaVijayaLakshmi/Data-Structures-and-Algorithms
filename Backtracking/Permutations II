class Solution {
public:
    void recursion(vector<int>& num, int idx, vector<vector<int> > &res) {
        
        if (idx == num.size()) {
            res.push_back(num);
            return;
        }

        unordered_set<int> st;

        for (int i=idx; i<num.size() ; i++) {

            if(st.count(num[i])) continue;

            st.insert(num[i]);
            
            swap(num[i], num[idx]);
            recursion(num, idx+1, res);
            swap(num[i],num[idx]);


        }
    }
    vector<vector<int> > permuteUnique(vector<int> &num) {
        
        vector<vector<int> >res;
        recursion(num, 0, res);
        return res;
    }
};


