class Solution {
public:
    vector<vector<int>> res;

    void subsetWithDup(vector<int>& nums,int idx,vector<int> &curr){

        res.push_back(curr);
        
        for(int i=idx;i<nums.size();i++){

         //comparing with i with i-1 not idx
          if(i>idx && nums[i]==nums[i-1]) continue;

           curr.push_back(nums[i]);

           //here it shuld be i+1, becuase the next lement should be i+1
           subsetWithDup(nums,i+1,curr);
           curr.pop_back();

        }

    }


    vector<vector<int>> subsetsWithDup(vector<int>& nums) {

        sort(nums.begin(),nums.end());
        vector<int> curr;
        subsetWithDup(nums,0,curr);
        return res;
        
    }
};


