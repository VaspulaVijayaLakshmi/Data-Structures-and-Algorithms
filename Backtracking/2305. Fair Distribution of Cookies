class Solution {
public:

    int res=INT_MAX;

    void distributeCookies(vector<int>& cookies, int k,
    vector<int> &children,int idx){

        if(idx>=cookies.size()){
            
           int maxi = *max_element(children.begin(), 
           children.end());
 
           res = min(maxi,res);
           return ;

        }

        int cookie = cookies[idx];

        for(int i=0;i<k;i++){
            
            children[i]+=cookie;
            distributeCookies(cookies,k,children,idx+1);
            children[i]-=cookie;
        }

    }



    int distributeCookies(vector<int>& cookies, int k) {

        vector<int> children(k,0);

        distributeCookies(cookies,k,children,0);
        return res;
        
    }
};


