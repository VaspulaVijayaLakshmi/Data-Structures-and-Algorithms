class Solution {
public:

bool isValid(vector<vector<char>>& board, int r, int c, char ch) {
    // row
    for (int j = 0; j < 9; j++)
        if (board[r][j] == ch) return false;

    // column
    for (int i = 0; i < 9; i++)
        if (board[i][c] == ch) return false;

    // 3x3 box
    int sr = (r / 3) * 3;
    int sc = (c / 3) * 3;

    for (int i = sr; i < sr + 3; i++) {
        for (int j = sc; j < sc + 3; j++) {
            if (board[i][j] == ch) return false;
        }
    }

    return true;
}


    bool sudukoSolver(vector<vector<char>>& board){
         
         for(int i=0;i<9;i++){
            for(int j=0;j<9;j++){

                if(board[i][j]=='.'){

                    for(char ch='1';ch<='9';ch++){

                        if(isValid(board,i,j,ch)){
                            board[i][j]=ch;

                            if(sudukoSolver(board))
                               return true;

                            board[i][j]='.';
                        }
                    }

//if I tried all the chars of the board for this position, and still i was getting false, then return false;
//board cant be solved
                return false;

                }

            }
         }

         return true;
    }

    

    void solveSudoku(vector<vector<char>>& board) {

        sudukoSolver(board);
        
    }
};
