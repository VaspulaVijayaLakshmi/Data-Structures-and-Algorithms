class Solution {
public:
    int res=0;
    void maximumRequests(int n, vector<vector<int>>& requests,  vector<int> &balance,int idx,int count){

        if(idx>=requests.size()){
            
              for(int i=0;i<n;i++){
                 if(balance[i]!=0){
                    return ;
                 }
              }

              res = max(res,count);
              return ;
        }

        //consider this request
        balance[requests[idx][0]]--;
        balance[requests[idx][1]]++;
        
        maximumRequests(n,requests,balance,idx+1,count+1);
        
        //backtrack
        balance[requests[idx][0]]++;
        balance[requests[idx][1]]--;

        //skip
        maximumRequests(n,requests,balance,idx+1,count);
       
    }

    int maximumRequests(int n, vector<vector<int>>& requests) {
        
        vector<int> balance(n,0);
        maximumRequests(n,requests,balance,0,0);

        return res;

    }
};



