class Solution {
public:
    vector<vector<int>> res;

    void permuate(vector<int>& nums,int idx){

        if(idx>=nums.size()){
            res.push_back(nums);
            return ;
        }

        for(int i=idx;i<nums.size();i++){

            swap(nums[i],nums[idx]);
            permuate(nums,idx+1);
            //swap back
            swap(nums[i],nums[idx]);
        }

    }


    vector<vector<int>> permute(vector<int>& nums) {

     permuate(nums,0); 
     return res;
        
    }
};

