class Solution {

    class TrieNode{

    TrieNode[] children;
    String word;

    TrieNode(){
        children = new TrieNode[26];
    }
}


class Trie{

  TrieNode root;
  
  Trie() {
    root = new TrieNode();
  }


  void insert(String word){

       TrieNode curr=root;
       for(char ch: word.toCharArray()){
          
          int idx= ch-'a';

          if(curr.children[idx]==null)
              curr.children[idx] = new TrieNode();

            curr=curr.children[idx];  
            
       }

       curr.word = word;
  }

}

void dfs(char[][] board,TrieNode root,int x,int y,List<String> res){

    if(x<0 || y<0 || x>=board.length || y>=board[0].length)
     return;

    if(board[x][y] == '#')
      return;


    char ch= board[x][y]; 
    int idx = ch-'a';

    //no child 
    //the char present on board, is not present in the trie
    if(root.children[idx]== null)
      return; 

    //mark as visited on board
    board[x][y] = '#';

    // Move in Trie
    TrieNode next = root.children[idx];

    //Did we find a complete word?
    if (next.word != null) {
        res.add(next.word);
        next.word=null;
    }

    dfs(board,next,x+1,y,res);
    dfs(board,next,x-1,y,res);
    dfs(board,next,x,y+1,res);
    dfs(board,next,x,y-1,res);


    //backtrack
    board[x][y]=ch;

}

    public List<String> findWords(char[][] board, String[] words) {

        Trie trie = new Trie();
        for(int i=0;i<words.length;i++){
             trie.insert(words[i]);
        }

        int r=board.length;
        int c=board[0].length;

        List<String> res = new ArrayList<>();

        //dfs call
        for(int i=0;i<r;i++){
            for(int j=0;j<c;j++){
                
                dfs(board,trie.root,i,j,res);
            }
        }

        return res;
        
    }
}


