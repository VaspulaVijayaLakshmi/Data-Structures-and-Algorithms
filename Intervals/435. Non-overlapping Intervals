class Solution {
public:
    int eraseOverlapIntervals(vector<vector<int>>& intervals) {

        int c=0;

        sort(intervals.begin(),intervals.end(),[](auto &a,auto &b){
            return a[1]<b[1];
        });


        int e=intervals[0][1];

        for(int i=1;i<intervals.size();i++){

            if(intervals[i][0] < e){
                c++;

                //since sorted by end - this is not need
                // e = min(intervals[i][1],e);
            }

            else{
                 e=intervals[i][1];
            }
     
        }

        return c;
        
    }
};



