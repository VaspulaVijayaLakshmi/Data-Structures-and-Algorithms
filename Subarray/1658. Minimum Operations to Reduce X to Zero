class Solution {
public:
    int minOperations(vector<int>& nums, int x, int left, int right) {

        // Successfully removed elements summing to x
        if(x == 0)
            return 0;

        // Impossible, left pointer and right pointer
        if(x < 0 || left > right)
            return INT_MAX;

        int l = minOperations(
            nums,
            x - nums[right],
            left,
            right - 1
        );

        int r = minOperations(
            nums,
            x - nums[left],
            left + 1,
            right
        );

        int ans = min(l, r);

        if(ans == INT_MAX)
            return INT_MAX;

        return 1 + ans;
    }

    int minOperations(vector<int>& nums, int x) {

        int ans = minOperations(nums, x, 0, nums.size() - 1);
        return ans == INT_MAX ? -1 : ans;
    }
};

