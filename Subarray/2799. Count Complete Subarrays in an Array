class Solution {
public:
    int countCompleteSubarrays(vector<int>& nums) {

        unordered_set<int> st(nums.begin(), nums.end());
        int totalDistinct = st.size();

        unordered_map<int, int> mp;

        int left = 0;
        int res = 0;

        for(int right = 0; right < nums.size(); right++) {

            mp[nums[right]]++;

            while(mp.size() == totalDistinct) {

                // Every ending index from right to n-1
                // gives a complete subarray starting at left
                res += nums.size() - right;

                mp[nums[left]]--;

                if(mp[nums[left]] == 0)
                    mp.erase(nums[left]);

                left++;
            }
        }

        return res;
    }
};



