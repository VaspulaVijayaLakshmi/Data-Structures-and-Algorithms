class Solution {
public:
    int subarraysDivByK(vector<int>& nums, int k) {

       //remainder, count subarrays  
       //which are divisble for k
        unordered_map<int,int> mp;
        mp[0]=1;

        int subArrays=0,prefix=0;

        for(int i=0;i<nums.size();i++){
            prefix+=nums[i];

            int remainder = prefix%k;

            if(remainder < 0)
                remainder += k;


            //that remainder is seen before
            if(mp.find(remainder) !=mp.end()){
                 subArrays += mp[remainder];
            }

            
            mp[remainder]++;

        }

        return subArrays;
        
    }
};





