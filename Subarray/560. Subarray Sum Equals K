class Solution {
public:
    int subarraySum(vector<int>& nums, int k) {

        int c=0,prefix=0;

        //map stores prefix sum, number of subarrays.
        unordered_map<int,int> mp;
        mp[0]=1;

        for(int i=0;i<nums.size();i++){
            
            prefix+=nums[i];

            if(mp.find(prefix-k)!=mp.end())
               c+=mp[prefix-k];

              mp[prefix]++;

        }

        return c;
        
    }
};




