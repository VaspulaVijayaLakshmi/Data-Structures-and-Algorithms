class Solution {
  public:
    int cntSubarrays(vector<int> &arr, int k) {
     
     
     int prefix=0;
     int c=0;
     
     //map will store the element along with counts of subarrays 
    //  with tht sum K till now
    
     unordered_map<int,int> mp;
     mp[0]=1;
     
     for(int i=0;i<arr.size();i++){
         
         prefix+=arr[i];
         
         if(mp.find(prefix-k) != mp.end()){
             c+= mp[prefix-k];
         }
         
         
         mp[prefix]++;
           
     }
     
     return c;
    }
};

