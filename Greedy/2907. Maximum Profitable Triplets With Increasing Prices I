class Solution {
public:
    int maxProfit(vector<int>& prices, vector<int>& profits) {
        int n = prices.size();

        vector<int> left(n, -1);
        vector<int> right(n, -1);

        // Find best first element for every middle element
        for (int j = 0; j < n; j++) {
            for (int i = 0; i < j; i++) {
                if (prices[i] < prices[j]) {
                    left[j] = max(left[j], profits[i]);
                }
            }
        }

        // Find best third element for every middle element
        for (int j = 0; j < n; j++) {
            for (int k = j + 1; k < n; k++) {
                if (prices[j] < prices[k]) {
                    right[j] = max(right[j], profits[k]);
                }
            }
        }

        int ans = -1;

        for (int j = 0; j < n; j++) {
            if (left[j] != -1 && right[j] != -1) {
                ans = max(ans,
                          left[j] + profits[j] + right[j]);
            }
        }

        return ans;
    }
};
