class TopVotedCandidate {
public:

    vector<int> times;
    vector<int> leaders;

    TopVotedCandidate(vector<int>& persons, vector<int>& t) {

        unordered_map<int,int> count;

        int leader = -1;

        for(int i = 0; i < persons.size(); i++) {

            count[persons[i]]++;

            if(leader == -1 || count[persons[i]] >= count[leader])
                leader = persons[i];

            times.push_back(t[i]);
            leaders.push_back(leader);
        }
    }
    
    int q(int t) {

        // last time <= t
        int idx = upper_bound(times.begin(), times.end(), t)
                  - times.begin() - 1;

        return leaders[idx];
    }
};
