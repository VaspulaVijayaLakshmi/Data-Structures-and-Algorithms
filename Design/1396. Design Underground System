class UndergroundSystem {
public: 
    unordered_map<int,pair<string,int>> mp ;
    unordered_map<string,pair<int,int>> avgMap;
    
    UndergroundSystem() {}
    
    void checkIn(int id, string stationName, int t) {
        mp[id] = {stationName,t};
    }
    
    void checkOut(int id, string stationName, int t) {
        
        string srcStation = mp[id].first;
        int strtTime = mp[id].second;
        
        string key = srcStation + "#" + stationName;
        
        //not present in. map
        if(avgMap.find(key) == avgMap.end()){
             avgMap[key] = {(t-strtTime),1};
             return ;
        }

        else{
            auto val = avgMap[key];
            avgMap[key] = {(val.first + (t-strtTime)) , 
                            val.second+1};
        }

    }
    
    double getAverageTime(string startStation, string endStation) {
         
         string key = startStation + "#" + endStation;
         auto val = avgMap[key];

         return (double)(val.first)/val.second;
    }
};

