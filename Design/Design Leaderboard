Problem Description
You need to design a Leaderboard class that manages player scores and provides functionality to track top performers.

The Leaderboard class must implement three main functions:

addScore(playerId, score): This function adds points to a player's current score. If the player doesn't exist on the leaderboard yet, they are added with the given score as their initial score. If they already exist, the score is added to their existing total.

top(K): This function returns the sum of scores of the top K players. The top players are those with the highest scores on the leaderboard.

reset(playerId): This function removes a player from the leaderboard by resetting their score to 0. The problem guarantees that this function will only be called for players who already exist on the leaderboard.





class Leaderboard {
    unordered_map<int, int> score;
    unordered_set<int> removed;

    // {score, playerId}
    priority_queue<pair<int,int>> pq;

public:

    void addScore(int playerId, int points) {
        score[playerId] += points;

        pq.push({score[playerId], playerId});
    }

    void removePlayer(int playerId) {
        if (score.count(playerId)) {
            removed.insert(playerId);
            score.erase(playerId);
        }
    }

    vector<int> getTopK(int k) {
        vector<int> ans;

        while (!pq.empty() && ans.size() < k) {

            auto [sc, id] = pq.top();
            pq.pop();

            // stale / removed entry - (blacklisted, score is present for tht user, and it is stale)
            if (removed.count(id) || !score.count(id) || score[id] != sc) {
                continue;
            }

            ans.push_back(id);

            // Put it back because getTopK shouldn't remove
            pq.push({sc, id});
        }

        return ans;
    }
};
