class RandomizedSet {
public:

    unordered_map<int,int> mp;
    vector<int> nums;

    RandomizedSet() { }
    
    bool insert(int val) {

        if(mp.find(val) == mp.end()){
        
           nums.push_back(val);
           mp[val] = nums.size()-1;
           return true;
        }

        return false;
    }
    
    bool remove(int val) {

        //if not present return false
        if(mp.find(val) == mp.end())
          return false;

        //find the idx of that elemennt
        int idx = mp[val];

        //replace with last element
        int lastIdx = nums.size()-1;
        nums[idx] = nums[lastIdx];
        mp[nums[lastIdx]] = idx;

        //cleqr from vector
        //cleqr from map
        mp.erase(val);
        nums.pop_back();

        return true;   
        
    }
    
    int getRandom() {
        
        return nums[rand()%nums.size()];
    }
};

