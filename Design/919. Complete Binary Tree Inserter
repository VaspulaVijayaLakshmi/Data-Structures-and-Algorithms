/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     TreeNode *left;
 *     TreeNode *right;
 *     TreeNode() : val(0), left(nullptr), right(nullptr) {}
 *     TreeNode(int x) : val(x), left(nullptr), right(nullptr) {}
 *     TreeNode(int x, TreeNode *left, TreeNode *right) : val(x), left(left), right(right) {}
 * };
 */
class CBTInserter {
public:
    
    TreeNode* treeRoot;
    CBTInserter(TreeNode* root) {
        treeRoot=root;
    }

    TreeNode* findParent(){
        
        queue<TreeNode*> q;
        q.push(treeRoot);

        while(!q.empty()) {

            TreeNode* node = q.front();
            q.pop();

            if(node->left == NULL || node->right == NULL)
                return node;

            q.push(node->left);
            q.push(node->right);
        }

        return NULL;


    }
    
    int insert(int val) {
       
        //treenode is empty
        if(treeRoot==NULL){
            treeRoot=new TreeNode(val);
            return -1;
        }

        //tree is supposed to be complete tree
        //find parent of the last node in the tree

        TreeNode* parent= findParent();

        if(parent->left ==NULL){
            parent->left = new TreeNode(val);
        }
        else{
            parent->right = new TreeNode(val);
        }

        return parent->val;
 
    }
    
    TreeNode* get_root() {
        return treeRoot;
    }
};

