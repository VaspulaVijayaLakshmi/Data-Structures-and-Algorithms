class Twitter {
public:
    
    int timestamp=0;

    //list would be DLL right
    unordered_map<int,list<pair<int,int>>> posts;
    unordered_map<int,set<int>> following;

    Twitter() {}
    
    void postTweet(int userId, int tweetId) {
       
       posts[userId].push_front({timestamp++, tweetId});

        if (posts[userId].size() > 10) {
           posts[userId].pop_back();
        }
    }
    
    
    vector<int> getNewsFeed(int userId) {
        
        //go to all users following and their tweets
        //along with himself/herself

        //then sort and pick top 10.

        // Min heap: oldest tweet is on top
        priority_queue<
            pair<int, int>,
            vector<pair<int, int>>,
            greater<pair<int, int>>
        > pq;

        // Myself + everyone I follow
        set<int> users = following[userId];
        users.insert(userId);

        // Go through tweets of all relevant users
        for (int user : users) {

            for (auto tweet : posts[user]) {

                pq.push(tweet);

                // Keep only 10 most recent tweets
                if (pq.size() > 10) {
                    pq.pop();
                }
            }
        }

        // Extract tweets from oldest -> newest
        vector<int> ans;

        while (!pq.empty()) {
            ans.push_back(pq.top().second);
            pq.pop();
        }

        // We need newest -> oldest
        reverse(ans.begin(), ans.end());

        return ans;
    }

    void follow(int followerId, int followeeId) {
        following[followerId].insert(followeeId);
    }
    
    void unfollow(int followerId, int followeeId) {
        following[followerId].erase(followeeId);
    }
};





