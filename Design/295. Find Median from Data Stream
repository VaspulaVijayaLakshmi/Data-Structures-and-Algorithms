class MedianFinder {
public:
    
    priority_queue<int> pq1;
    priority_queue<int,vector<int>,greater<int>> pq2;

    MedianFinder() {}
    
    void addNum(int num) {
        
        pq1.push(num);
               //make all elements of heap1 less than heap2
       if(!pq2.empty() && pq1.top() > pq2.top()){
            int top=pq1.top();
            pq1.pop();
            pq2.push(top);
       }

      //balance heaps
       if(pq1.size() > pq2.size()+1){
            
            pq2.push(pq1.top());
            pq1.pop();
       }

       else if(pq2.size() > pq1.size()+1){
            
            pq1.push(pq2.top());
            pq2.pop();
       }

        
    }
    
    double findMedian() {

        //sizes are equal
        if(pq1.size() == pq2.size())
          return (pq1.top()+pq2.top())/2.0;

        else if(pq1.size() > pq2.size())
         return pq1.top();

        return pq2.top(); 
        
    }
};



